{
  "name": "homestay-review-my",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "typecheck": "astro check",
    "deploy": "astro build && wrangler pages deploy ./dist",
    "db:init:local": "wrangler d1 execute homestay-review-db --local --file=./db/schema.sql",
    "db:init:remote": "wrangler d1 execute homestay-review-db --remote --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute homestay-review-db --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute homestay-review-db --remote --file=./db/seed.sql"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "12.6.10",
    "astro": "^5.13.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "wrangler": "^4.127.1"
  }
}
