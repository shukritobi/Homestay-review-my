{
  "name": "homestay-review-my",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types --strict-vars=false && astro dev",
    "build": "wrangler types --strict-vars=false && astro build",
    "preview": "wrangler types --strict-vars=false && astro preview",
    "typecheck": "wrangler types --strict-vars=false && astro check",
    "deploy": "wrangler types --strict-vars=false && astro build && wrangler deploy",
    "db:init:local": "wrangler d1 execute homestay-review-db --local --file=./db/schema.sql",
    "db:init:remote": "wrangler d1 execute homestay-review-db --remote --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute homestay-review-db --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute homestay-review-db --remote --file=./db/seed.sql"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.2.5",
    "astro": "7.2.9",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
