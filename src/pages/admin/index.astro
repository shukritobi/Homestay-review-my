---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAdminIdentity } from '../../lib/admin';
import { getAdminStats, listPendingReviews } from '../../lib/db';
const moderator = getAdminIdentity(Astro.request, env);
const db = env.DB;

let pending: Awaited<ReturnType<typeof listPendingReviews>> = [];
let stats = { pending: 0, flagged: 0, approved: 0, rejected: 0, approvedToday: 0, newListings: 0 };
let loadError = false;

if (!moderator) {
  Astro.response.status = 401;
} else if (db) {
  try {
    [pending, stats] = await Promise.all([listPendingReviews(db), getAdminStats(db)]);
  } catch (error) {
    console.error('Admin dashboard query failed', error);
    loadError = true;
  }
}

const maskEmail = (email: string) => {
  const [local, domain] = email.split('@');
  if (!domain) return 'hidden';
  return `${local.slice(0, Math.min(3, local.length))}***@${domain}`;
};

const formatDate = (value: string) => {
  const date = new Date(`${value.replace(' ', 'T')}Z`);
  return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat('en-MY', {
    day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kuala_Lumpur'
  }).format(date);
};
---

<BaseLayout title="Moderation queue | HomestayReview.my" wide>
  {!moderator ? (
    <section class="form-shell verification-shell">
      <div class="form-card verification-card">
        <p class="eyebrow">Private area</p>
        <div class="big-check neutral-check">🔒</div>
        <h1>Admin access required.</h1>
        <p>This route is designed to sit behind Cloudflare Access. Sign in through the protected admin application to continue.</p>
        <div class="verification-actions"><a class="button button-dark" href="/">Back to public site</a></div>
      </div>
    </section>
  ) : (
    <section class="admin-shell">
      <div class="admin-top">
        <div>
          <span class="admin-badge">Private admin</span>
          <h1>Moderation queue</h1>
          <p>Nothing public until you say so. Signed in as {moderator}.</p>
        </div>
        <a class="button button-light button-small" href="/">View public site ↗</a>
      </div>

      {loadError && <div class="system-notice"><strong>Database query failed.</strong><span>No moderation action was taken.</span></div>}

      <div class="admin-stats">
        <div class="stat-card"><span>Pending</span><strong id="pendingStat">{stats.pending}</strong></div>
        <div class="stat-card"><span>Approved today</span><strong id="approvedStat">{stats.approvedToday}</strong></div>
        <div class="stat-card"><span>Flagged</span><strong id="flaggedStat">{stats.flagged}</strong></div>
        <div class="stat-card"><span>Total approved</span><strong>{stats.approved}</strong></div>
      </div>

      <div class="moderation-layout">
        <nav class="admin-nav" aria-label="Moderation sections">
          <button class="active" type="button" data-filter="all">Queue <span>{pending.length}</span></button>
          <button type="button" data-filter="pending">Pending <span>{stats.pending}</span></button>
          <button type="button" data-filter="flagged">Flagged <span>{stats.flagged}</span></button>
          <button type="button" data-filter="new-listing">New listings <span>{stats.newListings}</span></button>
          <div class="admin-nav-divider"></div>
          <div class="admin-nav-static"><span>Rejected</span><b>{stats.rejected}</b></div>
          <div class="admin-nav-static"><span>Approved</span><b>{stats.approved}</b></div>
        </nav>

        <div>
          <div class="feed-toolbar">
            <p><strong>Verified submissions</strong> · newest first</p>
            <span class="queue-count"><b id="visibleQueueCount">{pending.length}</b> shown</span>
          </div>

          <div class="queue" id="queue">
            {pending.map((item) => (
              <article
                class="queue-card"
                data-id={item.id}
                data-status={item.status}
                data-new-listing={item.homestayStatus === 'pending' ? '1' : '0'}
              >
                <div class="queue-body">
                  <div class="queue-meta">
                    <div>
                      <span>{item.city}, {item.state}</span>
                      <h3>{item.homestayName}</h3>
                    </div>
                    <span class:list={["admin-risk", item.risk === 'New homestay' && 'risk-new', item.risk === 'Flagged' && 'risk-flagged']}>{item.risk}</span>
                  </div>
                  <div class="review-card-head">
                    <div>
                      <div class="stars" style="color:#d99500">{'★'.repeat(item.rating)}{'☆'.repeat(5 - item.rating)}</div>
                      <strong>{item.title}</strong>
                    </div>
                    {item.tripType && <span class="review-stay">{item.tripType}</span>}
                  </div>
                  <p class="queue-review">“{item.body}”</p>
                  <div class="queue-author">
                    <span><strong>{item.author}</strong></span>
                    <span>✓ {maskEmail(item.email)}</span>
                    <span>{formatDate(item.submittedAt)}</span>
                    {item.stayYear && <span>Stayed {item.stayMonth ? `${item.stayMonth}/` : ''}{item.stayYear}</span>}
                  </div>
                  {item.homestayStatus === 'pending' && (
                    <div class="new-listing-warning"><strong>Approving this review also activates this new homestay listing.</strong></div>
                  )}
                </div>
                <div class="queue-actions">
                  <button class="reject" type="button" data-action="reject">Reject</button>
                  <button type="button" data-action="flag">Flag</button>
                  <button type="button" data-action="changes">Request change</button>
                  <button class="approve" type="button" data-action="approve">Approve ✓</button>
                </div>
                <div class="moderation-note-row">
                  <input class="moderation-note" maxlength="500" placeholder="Optional moderator note" aria-label="Moderator note" />
                  <span class="action-status" role="status"></span>
                </div>
              </article>
            ))}
          </div>

          {pending.length === 0 && (
            <div id="queueEmpty" class="empty-review-card admin-empty">
              <div class="big-check">✓</div>
              <h3>Queue clear.</h3>
              <p>There are no verified reviews waiting for moderation.</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <script>
    const pendingStat = document.querySelector('#pendingStat');
    const approvedStat = document.querySelector('#approvedStat');
    const flaggedStat = document.querySelector('#flaggedStat');
    const visibleCount = document.querySelector('#visibleQueueCount');
    const cards = [...document.querySelectorAll('.queue-card')];
    let activeFilter = 'all';

    function refreshVisibleCount() {
      const shown = cards.filter((card) => !card.classList.contains('removed') && card.style.display !== 'none').length;
      if (visibleCount) visibleCount.textContent = String(shown);
    }

    document.querySelectorAll('.admin-nav button[data-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter || 'all';
        document.querySelectorAll('.admin-nav button[data-filter]').forEach((item) => item.classList.remove('active'));
        button.classList.add('active');

        cards.forEach((card) => {
          const matches = activeFilter === 'all' ||
            (activeFilter === 'pending' && card.dataset.status === 'pending') ||
            (activeFilter === 'flagged' && card.dataset.status === 'flagged') ||
            (activeFilter === 'new-listing' && card.dataset.newListing === '1');
          card.style.display = matches && !card.classList.contains('removed') ? '' : 'none';
        });
        refreshVisibleCount();
      });
    });

    document.querySelectorAll('.queue-actions button').forEach((button) => {
      button.addEventListener('click', async () => {
        const card = button.closest('.queue-card');
        if (!card) return;
        const action = button.dataset.action;
        const reviewId = card.dataset.id;
        const note = card.querySelector('.moderation-note')?.value || '';
        const status = card.querySelector('.action-status');
        const allButtons = card.querySelectorAll('.queue-actions button');
        allButtons.forEach((item) => item.disabled = true);
        status.textContent = 'Saving…';

        try {
          const response = await fetch(`/api/admin/reviews/${reviewId}/action`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action, note })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) throw new Error(data.error || 'Moderation failed.');

          if (action === 'flag' || action === 'changes') {
            card.dataset.status = data.status;
            status.textContent = action === 'flag' ? 'Flagged ✓' : 'Changes requested ✓';
            if (action === 'flag' && flaggedStat) flaggedStat.textContent = String(Number(flaggedStat.textContent || 0) + 1);
            allButtons.forEach((item) => item.disabled = false);
            return;
          }

          card.classList.add('removed');
          card.style.display = 'none';
          status.textContent = action === 'approve' ? 'Approved ✓' : 'Rejected ✓';
          if (pendingStat && card.dataset.status === 'pending') pendingStat.textContent = String(Math.max(0, Number(pendingStat.textContent || 0) - 1));
          if (approvedStat && action === 'approve') approvedStat.textContent = String(Number(approvedStat.textContent || 0) + 1);
          refreshVisibleCount();
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Could not save.';
          allButtons.forEach((item) => item.disabled = false);
        }
      });
    });
  </script>
</BaseLayout>
