---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { listHomestays } from '../lib/db';
import { calculateHomestayScore } from '../lib/score';
import { getAdditionalScoreSources } from '../data/externalRatings';
import { COMMUNITY_LISTINGS } from '../data/communityListings';
import { getRawPublicReviews } from '../data/rawPublicReviews';

const db = env.DB;
let homestays: Awaited<ReturnType<typeof listHomestays>> = [];
let loadError = false;

try {
  homestays = db ? await listHomestays(db) : [];
} catch (error) {
  console.error('Directory query failed', error);
  loadError = true;
}

const dbItems = homestays.map((stay) => {
  const hScore = calculateHomestayScore({
    homestayReviewRating: stay.averageRating,
    homestayReviewCount: stay.reviewCount,
    googleRating: stay.googleRating,
    googleReviewCount: stay.googleReviewCount,
    additionalSources: getAdditionalScoreSources(stay.slug)
  });
  const rawReviews = getRawPublicReviews(stay.slug);
  const ownText = stay.latestReview || '';
  return {
    name: stay.name,
    slug: stay.slug,
    city: stay.city,
    state: stay.state,
    score: hScore.score,
    evidenceCount: hScore.evidenceCount,
    text: ownText || rawReviews[0]?.text || '',
    textSource: ownText ? 'HomestayReview.my' : (rawReviews[0]?.sourceLabel || ''),
    textCount: stay.reviewCount + rawReviews.length
  };
});

const knownSlugs = new Set(dbItems.map((item) => item.slug));
const communityItems = COMMUNITY_LISTINGS
  .filter((item) => !knownSlugs.has(item.slug))
  .map((item) => {
    const rawReviews = getRawPublicReviews(item.slug);
    return {
      ...item,
      score: null as number | null,
      evidenceCount: 0,
      text: rawReviews[0]?.text || '',
      textSource: rawReviews[0]?.sourceLabel || '',
      textCount: rawReviews.length
    };
  });

const rankedHomestays = [...dbItems, ...communityItems]
  .sort((a, b) => (b.score || 0) - (a.score || 0) || b.evidenceCount - a.evidenceCount || a.name.localeCompare(b.name));
const states = [...new Set(rankedHomestays.map((stay) => stay.state))].sort();
---

<BaseLayout wide title="HomestayReview.my">
  <div class="hlist-app">
    <section class="hlist-topline compact-topline">
      <div class="hlist-pitch"><h1>Homestays in Malaysia</h1></div>
    </section>

    <section class="hlist-controls" aria-label="Search and filters">
      <label class="hlist-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="searchInput" type="search" placeholder="Search homestay or place" autocomplete="off" />
      </label>
      <select id="stateFilter" class="hlist-control" aria-label="Filter by state">
        <option value="">All Malaysia</option>
        {states.map((state) => <option value={state}>{state}</option>)}
      </select>
      <select id="scoreFilter" class="hlist-control" aria-label="Minimum score">
        <option value="0">Any score</option><option value="90">90+</option><option value="85">85+</option><option value="80">80+</option>
      </select>
      <select id="sortFilter" class="hlist-control" aria-label="Sort results">
        <option value="score">Best score</option><option value="reviews">Most reviews</option><option value="name">A to Z</option>
      </select>
      <a class="hlist-review-cta" href="/review/submit">+ Review</a>
    </section>

    <section class="hlist-main">
      <div class="hlist-results">
        <div class="hlist-results-head"><p><strong id="resultCount">{rankedHomestays.length}</strong> homestays</p></div>
        {loadError && <div class="hlist-load-error"><strong>Could not load listings.</strong></div>}

        <div id="listingFeed" class="hlist-list">
          {rankedHomestays.map((stay, index) => (
            <a class="hlist-card lean-card" href={`/homestay/${stay.slug}`}
              data-name={stay.name.toLowerCase()} data-display-name={stay.name}
              data-city={stay.city.toLowerCase()} data-state={stay.state}
              data-score={stay.score || 0} data-evidence={stay.evidenceCount}>
              <div class="hlist-score"><strong>{stay.score ?? '—'}</strong><small>SCORE</small></div>
              <div class="hlist-card-copy">
                <div class="hlist-card-top">
                  <span class="hlist-location">{stay.city} · {stay.state}</span>
                  {stay.score !== null && <span class="hlist-rank">#{String(index + 1).padStart(2, '0')}</span>}
                </div>
                <h2>{stay.name}</h2>
                <div class="lean-meta">
                  {stay.evidenceCount > 0 && <strong>{stay.evidenceCount.toLocaleString()} reviews</strong>}
                  {stay.evidenceCount === 0 && stay.textCount > 0 && <strong>{stay.textCount} review{stay.textCount === 1 ? '' : 's'}</strong>}
                  {stay.textSource && <span class="raw-source">VERBATIM · {stay.textSource}</span>}
                </div>
                {stay.text && <p class="hlist-blurb lean-review">“{stay.text}”</p>}
              </div>
              <span class="hlist-arrow" aria-hidden="true">›</span>
            </a>
          ))}
        </div>

        <div id="emptyState" class="hlist-empty" hidden><strong>No matching homestays.</strong></div>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const searchInput=document.querySelector('#searchInput');
      const stateFilter=document.querySelector('#stateFilter');
      const scoreFilter=document.querySelector('#scoreFilter');
      const sortFilter=document.querySelector('#sortFilter');
      const feed=document.querySelector('#listingFeed');
      const count=document.querySelector('#resultCount');
      const empty=document.querySelector('#emptyState');
      const cards=Array.from(document.querySelectorAll('.hlist-card'));
      const apply=()=>{
        const q=(searchInput?.value||'').trim().toLowerCase();
        const state=stateFilter?.value||'';
        const min=Number(scoreFilter?.value||0);
        const sort=sortFilter?.value||'score';
        const visible=cards.filter((card)=>{
          const hay=`${card.dataset.name||''} ${card.dataset.city||''} ${card.dataset.state||''}`.toLowerCase();
          const score=Number(card.dataset.score||0);
          return(!q||hay.includes(q))&&(!state||card.dataset.state===state)&&(!min||score>=min);
        });
        cards.forEach((card)=>card.hidden=!visible.includes(card));
        visible.sort((a,b)=>sort==='name'?(a.dataset.displayName||'').localeCompare(b.dataset.displayName||''):sort==='reviews'?Number(b.dataset.evidence||0)-Number(a.dataset.evidence||0):Number(b.dataset.score||0)-Number(a.dataset.score||0));
        visible.forEach((card)=>feed?.appendChild(card));
        if(count)count.textContent=String(visible.length);
        if(empty)empty.hidden=visible.length!==0;
      };
      [searchInput,stateFilter,scoreFilter,sortFilter].forEach((el)=>el?.addEventListener(el===searchInput?'input':'change',apply));
      apply();
    })();
  </script>
</BaseLayout>
