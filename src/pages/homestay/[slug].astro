---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomestayBySlug } from '../../lib/db';
import { calculateHomestayScore } from '../../lib/score';
import { getAdditionalScoreSources } from '../../data/externalRatings';
import { getCommunityListing } from '../../data/communityListings';
import { getVerifiedSocialMentions } from '../../data/socialMentions';
import { getPublicReviewSnippets } from '../../data/publicReviews';

const db = env.DB;
const slug = Astro.params.slug || '';
let stay: Awaited<ReturnType<typeof getHomestayBySlug>> = null;
try {
  stay = db ? await getHomestayBySlug(db, slug) : null;
} catch (error) {
  console.error('Homestay detail query failed', error);
}

const community = getCommunityListing(slug);
const exists = Boolean(stay || community);
if (!exists) Astro.response.status = 404;

const name = stay?.name || community?.name || '';
const city = stay?.city || community?.city || '';
const state = stay?.state || community?.state || '';
const mentions = exists ? getVerifiedSocialMentions(slug) : [];
const publicReviews = exists ? getPublicReviewSnippets(slug) : [];
const hScore = stay ? calculateHomestayScore({
  homestayReviewRating: stay.averageRating,
  homestayReviewCount: stay.reviewCount,
  googleRating: stay.googleRating,
  googleReviewCount: stay.googleReviewCount,
  additionalSources: getAdditionalScoreSources(stay.slug)
}) : null;
const evidenceCount = hScore?.evidenceCount || 0;
const ownReviews = stay?.reviews || [];
const fallbackReviewCount = mentions.length + publicReviews.length;
const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const formatStay = (month: number | null, year: number | null) => {
  if (!year) return '';
  return month && month >= 1 && month <= 12 ? `${monthNames[month - 1]} ${year}` : String(year);
};
const formatDate = (value?: string | null) => value ? new Intl.DateTimeFormat('en-MY',{day:'numeric',month:'short',year:'numeric'}).format(new Date(`${value}T00:00:00Z`)) : '';
---

<BaseLayout title={exists ? `${name} | HomestayReview.my` : 'Not found | HomestayReview.my'}>
  {!exists ? (
    <section class="form-shell verification-shell">
      <div class="form-card verification-card">
        <h1>Homestay not found.</h1>
        <a class="button button-dark" href="/">Back</a>
      </div>
    </section>
  ) : (
    <section class="lean-detail">
      <a class="lean-back" href="/">← All homestays</a>

      <div class="lean-detail-head">
        <div>
          <p class="lean-location">{city} · {state}</p>
          <h1>{name}</h1>
        </div>
        <div class="lean-big-score">
          <strong>{hScore?.score ?? '—'}</strong>
          <span>score</span>
        </div>
      </div>

      <div class="lean-count-row">
        {evidenceCount > 0 && <strong>{evidenceCount.toLocaleString()} reviews</strong>}
        {evidenceCount === 0 && fallbackReviewCount > 0 && <strong>{fallbackReviewCount} review{fallbackReviewCount === 1 ? '' : 's'}</strong>}
        <a href={`/review/submit${stay ? `?id=${stay.id}&stay=${encodeURIComponent(name)}` : `?stay=${encodeURIComponent(name)}`}`}>+ Write a review</a>
      </div>

      <div class="lean-review-list">
        {ownReviews.map((review) => (
          <article class="lean-review-card">
            <div class="lean-review-head">
              <div class="stars" aria-label={`${review.rating} out of 5`}>{'★'.repeat(review.rating)}{'☆'.repeat(5-review.rating)}</div>
              <span>{formatStay(review.stayMonth, review.stayYear)}</span>
            </div>
            <h2>{review.title}</h2>
            <p>“{review.body}”</p>
            <div class="lean-review-author"><strong>{review.author}</strong></div>
          </article>
        ))}

        {mentions.map((mention) => (
          <article class="lean-review-card community-card">
            <div class="lean-review-head"><span>{formatDate(mention.postedAt)}</span></div>
            <p>“{mention.summary}”</p>
            <div class="lean-review-author"><strong>{mention.author}</strong></div>
          </article>
        ))}

        {publicReviews.map((review) => (
          <article class="lean-review-card community-card">
            {review.postedAt && <div class="lean-review-head"><span>{formatDate(review.postedAt)}</span></div>}
            <p>“{review.summary}”</p>
            {review.author && <div class="lean-review-author"><strong>{review.author}</strong></div>}
          </article>
        ))}

        {ownReviews.length === 0 && mentions.length === 0 && publicReviews.length === 0 && (
          <div class="lean-no-review">
            <strong>No written reviews yet.</strong>
            <a class="button button-dark button-small" href={`/review/submit${stay ? `?id=${stay.id}&stay=${encodeURIComponent(name)}` : `?stay=${encodeURIComponent(name)}`}`}>Write the first review</a>
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>
