---
import '../styles/global.css';
import '../styles/production.css';
import '../styles/hotelist.css';
import '../styles/score.css';
import '../styles/review-service.css';
import '../styles/no-map.css';
import '../styles/social-links.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  map?: boolean;
}

const {
  title = 'HomestayReview.my',
  description = 'Homestay scores and reviews in Malaysia.',
  wide = false,
  map = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f2ee" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {map && <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class:list={['header-inner', wide && 'header-wide']}>
        <a class="brand" href="/" aria-label="HomestayReview.my home"><span>homestay</span><b>/</b><span>review</span><small>.my</small></a>
        <nav class="header-actions" aria-label="Primary navigation"><a class="button button-dark button-small" href="/review/submit">+ Review</a></nav>
      </div>
    </header>
    <main class:list={['page-shell', wide && 'page-shell-wide']}><slot /></main>
    <footer class="site-footer">
      <div class:list={['footer-inner', wide && 'header-wide']}>
        <p><strong>homestay/review.my</strong></p>
        <div class="footer-links"><a href="/">Browse</a><a href="/review/submit">Review</a></div>
      </div>
    </footer>
  </body>
</html>
