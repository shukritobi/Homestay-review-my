{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homestay-review-my",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_URL": "https://homestayreview.my",
    "TURNSTILE_HOSTNAMES": "homestayreview.my,www.homestayreview.my",
    "EMAIL_FROM": "HomestayReview.my <reviews@homestayreview.my>"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "0d3da1dca3524ac7b333886db3132df1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homestay-review-db",
      "database_id": "f0f8dd74-52a6-466c-ae74-cad657f49839"
    }
  ]
}
